# Copy to .env and fill in. Every variable is validated at startup (src/config/env.ts).

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
MONGO_URL=mongodb://localhost:27017/royal_carrom
REDIS_URL=redis://localhost:6379
# Comma-separated origins for browser clients; empty allows any (the Android app doesn't need CORS).
CORS_ORIGINS=

# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-secret-value-please
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google: the OAuth *Web* client ID(s) your Android app requests ID tokens for.
GOOGLE_CLIENT_IDS=
# Facebook Login: App ID and App Secret from developers.facebook.com.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0

# Phone OTP delivery: "console" logs codes (development only), "twilio" uses Twilio Verify.
OTP_PROVIDER=console
OTP_PEPPER=change-me-otp-pepper
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Gameplay
TURN_SECONDS=20
MATCHMAKING_TICK_MS=1000
